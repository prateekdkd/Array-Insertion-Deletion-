#include <iostream>
using namespace std;

#define MAX 5

class Stack {
    int top;
    int arr[MAX];

public:
    Stack() { top = -1; }

    void push(int x) {
        if (top >= MAX - 1) {
            cout << "Stack Overflow\n";
        } else {
            arr[++top] = x;
            cout << x << " pushed\n";
        }
    }
    int main() {
    Stack s;
    s.push(10);
    s.push(20);
    
}
