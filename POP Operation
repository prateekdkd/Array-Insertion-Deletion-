#include <iostream>
using namespace std;

#define MAX 5

class Stack {
    int top;
    int arr[MAX];

public:
    Stack() { top = -1; }

    void pop() {
        if (top < 0) {
            cout << "Stack Underflow\n";
        } else {
            cout << arr[top--] << " popped\n";
        }
    }
};

int main() {
    Stack s;
    s.pop();
    s.pop();
    s.pop(); // Triggers Underflow
    return 0;
}
